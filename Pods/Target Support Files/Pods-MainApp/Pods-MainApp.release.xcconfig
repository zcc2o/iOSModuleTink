CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/ZCCAssetModule" "${PODS_ROOT}/Headers/Public/ZCCBaseAssetModule" "${PODS_ROOT}/Headers/Public/ZCCBenefitModule" "${PODS_ROOT}/Headers/Public/ZCCCertificateModule" "${PODS_ROOT}/Headers/Public/ZCCContractModule" "${PODS_ROOT}/Headers/Public/ZCCLogComponent" "${PODS_ROOT}/Headers/Public/ZCCMediator" "${PODS_ROOT}/Headers/Public/ZCCOrderModule" "${PODS_ROOT}/Headers/Public/ZCCProductModule" "${PODS_ROOT}/Headers/Public/ZCCUIComponent" "${PODS_ROOT}/Headers/Public/ZCCWebComponent"
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/ZCCAssetModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCBaseAssetModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCBenefitModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCCertificateModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCContractModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCLogComponent" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCMediator" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCOrderModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCProductModule" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCUIComponent" "${PODS_CONFIGURATION_BUILD_DIR}/ZCCWebComponent"
OTHER_LDFLAGS = $(inherited) -ObjC -l"ZCCAssetModule" -l"ZCCBaseAssetModule" -l"ZCCBenefitModule" -l"ZCCCertificateModule" -l"ZCCContractModule" -l"ZCCLogComponent" -l"ZCCMediator" -l"ZCCOrderModule" -l"ZCCProductModule" -l"ZCCUIComponent" -l"ZCCWebComponent" -framework "Foundation" -framework "UIKit" -framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCAssetModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCBaseAssetModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCBenefitModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCCertificateModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCContractModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCLogComponent" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCMediator" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCOrderModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCProductModule" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCUIComponent" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZCCWebComponent"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
